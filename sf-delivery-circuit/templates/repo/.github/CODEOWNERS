/force-app/main/default/permissionsets/   @ORG/architects @ORG/leads
/test-cases/                              @ORG/testers @ORG/leads
/.claude/                                 @ORG/architects @ORG/leads
/CLAUDE.md                                @ORG/architects @ORG/leads
/.coderabbit.yaml                         @ORG/architects @ORG/leads
/build.config.yml                         @ORG/architects @ORG/leads
/scripts/ci/                              @ORG/architects @ORG/leads
/.github/                                 @ORG/architects @ORG/leads
