{
  "name": "circuit-merge-architects-only",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "bypass_actors": [
    { "actor_id": "ARCHITECTS_TEAM_ID", "actor_type": "Team", "bypass_mode": "pull_request" }
  ],
  "rules": [ { "type": "update" } ]
}
