{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/templates/repo/.claude/hooks/circuit-guard.mjs\" --plugin",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
