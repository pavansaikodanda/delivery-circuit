{
  "name": "delivery-circuit",
  "displayName": "Delivery Circuit",
  "description": "Delivery Circuit v4 for Salesforce teams: what to do next for your role (Architect, Developer, QA, Lead), your connections and what is missing, in one sidebar. Logins only; no stored tokens.",
  "version": "0.1.0",
  "publisher": "conscendo",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integration": "node build.mjs && node test/integration/run.mjs",
    "preview": "node preview/serve.mjs",
    "screens": "node preview/screens.mjs",
    "package": "node build.mjs && npx @vscode/vsce package --no-dependencies --skip-license --out delivery-circuit.vsix",
    "test:vsix": "node test/integration/vsix.mjs"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deliveryCircuit",
          "title": "Delivery Circuit",
          "icon": "media/shared/icon.svg"
        }
      ]
    },
    "views": {
      "deliveryCircuit": [
        {
          "type": "webview",
          "id": "deliveryCircuit.home",
          "name": "Circuit"
        }
      ]
    },
    "commands": [
      {
        "command": "deliveryCircuit.refresh",
        "title": "Refresh",
        "category": "Delivery Circuit",
        "icon": "$(refresh)"
      },
      {
        "command": "deliveryCircuit.switchRole",
        "title": "Switch Role",
        "category": "Delivery Circuit"
      },
      {
        "command": "deliveryCircuit.newDesign",
        "title": "New Design from Transcript",
        "category": "Delivery Circuit"
      },
      {
        "command": "deliveryCircuit.openStory",
        "title": "Open Story",
        "category": "Delivery Circuit"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deliveryCircuit.refresh",
          "when": "view == deliveryCircuit.home",
          "group": "navigation"
        },
        {
          "command": "deliveryCircuit.switchRole",
          "when": "view == deliveryCircuit.home",
          "group": "2_circuit@1"
        },
        {
          "command": "deliveryCircuit.newDesign",
          "when": "view == deliveryCircuit.home",
          "group": "2_circuit@2"
        },
        {
          "command": "deliveryCircuit.openStory",
          "when": "view == deliveryCircuit.home",
          "group": "2_circuit@3"
        }
      ]
    },
    "configuration": {
      "title": "Delivery Circuit",
      "properties": {
        "deliveryCircuit.refreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "How often GitHub and Jira data refresh."
        },
        "deliveryCircuit.githubTeams": {
          "type": "object",
          "default": {
            "architect": "architects",
            "developer": "developers",
            "tester": "testers",
            "lead": "leads"
          },
          "description": "GitHub team slug for each role (tester = QA). Your roles come from your team membership.",
          "properties": {
            "architect": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "developer": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "tester": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "lead": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "additionalProperties": false
        },
        "deliveryCircuit.acliPath": {
          "type": "string",
          "default": "acli",
          "scope": "machine",
          "description": "Path of the Atlassian CLI (acli), if you use it. Without acli, Jira is read through your Atlassian MCP login. Read from your user settings only."
        },
        "deliveryCircuit.designReader": {
          "type": "string",
          "enum": [
            "claude",
            "off"
          ],
          "default": "claude",
          "enumDescriptions": [
            "Read Confluence design pages, Fireflies meetings and (without acli) Jira with a read-only `claude -p` call through your own MCP logins.",
            "Do not start read-only Claude calls."
          ],
          "description": "How design pages, Fireflies meetings and (without acli) Jira are read."
        },
        "deliveryCircuit.designReaderModel": {
          "type": "string",
          "default": "haiku",
          "description": "Claude model for the read-only reader."
        }
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "simple-icons": "16.37.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pavansaikodanda/delivery-circuit.git",
    "directory": "delivery-circuit-extension"
  }
}
