# Runtime dependencies (esbuild externals) ARE shipped from node_modules, except:
#  - the Agent SDK's platform package with its ~330 MB Claude Code binary; sessions and the testing engine use the
#    person's installed Claude Code instead (src/core/claude.ts, sdkClaudeExecutable()).
node_modules/@anthropic-ai/claude-agent-sdk-*/**
node_modules/.cache/**
